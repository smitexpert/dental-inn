includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/factories/
    level: 6
    ignoreErrors:
        # FormRequest rules() return type array<string, ...> — acceptable at this level
        - '#Method App\\Http\\Requests\\.*::rules\(\) return type has no value type specified in iterable type array\.#'
        # Resources return array<string, mixed> — acceptable at this level
        - '#Method App\\Http\\Resources\\.* return type has no value type specified in iterable type array\.#'
        # Repository contracts and Eloquent implementations use array $data / $filters — typed in phase sub-projects
        - '#Method App\\Repositories\\.* has parameter \$data with no value type specified in iterable type array\.#'
        - '#Method App\\Repositories\\.* has parameter \$filters with no value type specified in iterable type array\.#'
        - '#Method App\\Repositories\\Contracts\\UserRepository::paginate\(\) return type with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        - '#Method App\\Repositories\\Eloquent\\UserEloquentRepository::paginate\(\) return type with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        # All repository paginate() methods return LengthAwarePaginator without explicit generics — acceptable at level 6
        - '#Method App\\Repositories\\Contracts\\.*::paginate\(\) return type with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        - '#Method App\\Repositories\\Eloquent\\.*::paginate\(\) return type with generic interface Illuminate\\Contracts\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        - '#Method App\\Repositories\\Contracts\\.*::paginate\(\) return type with generic class Illuminate\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        - '#Method App\\Repositories\\Eloquent\\.*::paginate\(\) return type with generic class Illuminate\\Pagination\\LengthAwarePaginator does not specify its types: TKey, TValue#'
        # Eloquent relations typed via PHPDoc @property — generic params are documented in IDE/static analyser
        - '#Method App\\Models\\.*::(user|doctor|schedules|timeOffs|appointments|creator|patient|appointment)\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\(BelongsTo|HasMany) does not specify its types: T.*#'
        # BelongsTo $this-vs-self covariance — known PHPStan limitation
        - '#Method App\\Models\\.*::patient\(\) should return.*#'
        # LengthAwarePaginator->setCollection / getCollection are magic methods
        - '#Call to an undefined method Illuminate\\Contracts\\Pagination\\LengthAwarePaginator.*#'
        # Collection return types from repository interfaces are documented via @property in callers
        - '#Method App\\Repositories\\.* return type with generic class Illuminate\\Database\\Eloquent\\Collection does not specify its types: TKey, TModel#'
        # Repository methods accept untyped $data/$rows/$filters arrays — typed in the caller
        - '#has parameter \$[a-zA-Z]+ with no value type specified in iterable type array\.#'
        # BelongsToMany pivot rows are untyped at static-analysis level
        - '#Access to an undefined property App\\Models\\(Supplier|Product)::\$pivot\.#'
        # Strict comparison against null after a previous `!== null` check inside the same `isset` chain
        - '#Strict comparison using !== between mixed and null will always evaluate to true\.#'
